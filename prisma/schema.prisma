generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum AssessmentType {
  QUIZ
  ASSIGNMENT
  EXAM
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
  FREE
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  password       String
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  phone          String?
  organization   String?
  jobTitle       String?       @map("job_title")
  country        String?
  bio            String?
  role           Role          @default(STUDENT)
  status         AccountStatus @default(PENDING)
  failedAttempts Int           @default(0) @map("failed_attempts")
  lockedUntil    DateTime?     @map("locked_until")
  lastLoginAt    DateTime?     @map("last_login_at")
  lastLoginIp    String?       @map("last_login_ip")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  instructorCourses Course[] @relation("instructorCourses")

  refreshTokens                RefreshToken[]
  enrollments                  Enrollment[]
  submissions                  Submission[]
  certificates                 Certificate[]
  payments                     Payment[]
  auditLogs                    AuditLog[]
  sentMessages                 Message[]                    @relation("sender")
  receivedMessages             Message[]                    @relation("recipient")
  discussions                  Discussion[]
  discussionReplies            DiscussionReply[]
  cpdRecords                   CpdRecord[]
  lessonCompletions            LessonCompletion[]
  courseEvaluations            CourseEvaluation[]
  courseInstructorApplications CourseInstructorApplication[]
  studentGroupMemberships      StudentGroupMember[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  detail    String?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Course {
  id             String   @id @default(uuid())
  title          String
  subtitle       String?
  description    String?
  category       String
  level          String   @default("Intermediate")
  duration       String?
  thumbnailCode  String   @default("CR") @map("thumbnail_code")
  thumbnailColor String   @default("bg-brand-navy") @map("thumbnail_color")
  thumbnailImage String?  @map("thumbnail_image")
  price          Decimal  @default(0) @db.Decimal(10, 2)
  currency       String   @default("GHS")
  featured       Boolean  @default(false)
  published      Boolean  @default(false)
  format         String?
  targetGroup    String?  @map("target_group")
  instructorId   String?  @map("instructor_id")
  instructor     User?    @relation("instructorCourses", fields: [instructorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  modules                       Module[]
  enrollments                   Enrollment[]
  assessments                   Assessment[]
  payments                      Payment[]
  tags                          CourseTag[]
  facilitators                  CourseFacilitator[]
  outcomes                      CourseOutcome[]
  announcements                 Announcement[]
  discussions                   Discussion[]
  accessCodes                   CourseAccessCode[]
  certificates                  Certificate[]
  courseEvaluations             CourseEvaluation[]
  courseInstructorApplications  CourseInstructorApplication[]
  studentGroups                 StudentGroup[]

  @@map("courses")
}

// Stores valid access codes for each course.
// TODO: Replace with Hostinger DB lookup when ready.
model CourseAccessCode {
  id        String   @id @default(uuid())
  courseId   String   @map("course_id")
  code      String
  usedBy    String?  @map("used_by")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, code])
  @@index([code])
  @@map("course_access_codes")
}

model CourseTag {
  id       String @id @default(uuid())
  courseId  String @map("course_id")
  tag      String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([courseId, tag])
  @@map("course_tags")
}

model CourseFacilitator {
  id       String  @id @default(uuid())
  courseId  String  @map("course_id")
  name     String
  title    String?
  bio      String?
  email    String?
  phone    String?
  linkedIn String? @map("linkedin")
  photo    String?
  order    Int     @default(0)
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@map("course_facilitators")
}

model CourseOutcome {
  id       String @id @default(uuid())
  courseId  String @map("course_id")
  outcome  String
  order    Int    @default(0)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@map("course_outcomes")
}

model Module {
  id       String   @id @default(uuid())
  courseId  String   @map("course_id")
  title    String
  order    Int      @default(0)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id          String  @id @default(uuid())
  moduleId    String  @map("module_id")
  title       String
  facilitator String?
  duration    String?
  contentType String? @map("content_type")
  contentUrl  String? @map("content_url")
  order       Int     @default(0)
  module      Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]
  @@index([moduleId])
  @@map("lessons")
}

model Enrollment {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  courseId        String           @map("course_id")
  status         EnrollmentStatus @default(ACTIVE)
  progress       Int              @default(0)
  courseAccessId  String?          @map("course_access_id")
  enrolledAt     DateTime         @default(now()) @map("enrolled_at")
  completedAt    DateTime?        @map("completed_at")
  lastAccessAt   DateTime?        @map("last_access_at")
  grade          String?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model Assessment {
  id              String         @id @default(uuid())
  courseId        String         @map("course_id")
  title           String
  type            AssessmentType
  dueDate         DateTime?      @map("due_date")
  maxScore        Int            @default(100) @map("max_score")
  order           Int            @default(0)
  createdAt       DateTime       @default(now()) @map("created_at")
  mode            String         @default("INDIVIDUAL")
  groupId         String?        @map("group_id")
  questionFileUrl String?        @map("question_file_url")
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group           StudentGroup?  @relation(fields: [groupId], references: [id], onUpdate: NoAction)
  questions       Question[]
  submissions     Submission[]
  @@index([courseId])
  @@map("assessments")
}

model Submission {
  id           String           @id @default(uuid())
  assessmentId String           @map("assessment_id")
  userId       String           @map("user_id")
  status       SubmissionStatus @default(PENDING)
  score        Int?
  feedback     String?
  fileUrl      String?          @map("file_url")
  submittedAt  DateTime?        @map("submitted_at")
  gradedAt     DateTime?        @map("graded_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers      StudentAnswer[]
  @@unique([assessmentId, userId])
  @@index([userId])
  @@map("submissions")
}

model Certificate {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId        String    @map("user_id")
  courseId      String    @map("course_id")
  fileUrl       String    @map("file_url")
  availableFrom DateTime  @default(dbgenerated("'2026-05-28 09:00:00'::timestamp without time zone")) @map("available_from") @db.Timestamp(6)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([userId, courseId])
  @@map("certificates")
}

model CpdRecord {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  activity String
  points   Int
  type     String
  date     DateTime
  period   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("cpd_records")
}

model Payment {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  courseId   String        @map("course_id")
  amount    Decimal       @db.Decimal(10, 2)
  currency  String        @default("GHS")
  method    PaymentMethod
  reference String        @unique
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?     @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([courseId])
  @@map("payments")
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  audience  String   @default("all")
  courseId   String?  @map("course_id")
  author    String
  createdAt DateTime @default(now()) @map("created_at")
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@map("announcements")
}

model Discussion {
  id        String            @id @default(uuid())
  courseId   String            @map("course_id")
  userId    String            @map("user_id")
  title     String
  pinned    Boolean           @default(false)
  createdAt DateTime          @default(now()) @map("created_at")
  course    Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   DiscussionReply[]
  @@index([courseId])
  @@map("discussions")
}

model DiscussionReply {
  id           String     @id @default(uuid())
  discussionId String     @map("discussion_id")
  userId       String     @map("user_id")
  content      String
  createdAt    DateTime   @default(now()) @map("created_at")
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([discussionId])
  @@map("discussion_replies")
}

model Message {
  id        String    @id @default(uuid())
  senderId  String    @map("sender_id")
  recipientId String  @map("receiver_id")
  content   String
  read      Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  parentId  String?   @map("parent_id")
  subject   String?   @default("")
  parent    Message?  @relation("messageThread", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Message[] @relation("messageThread")
  sender    User      @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User      @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
  @@map("messages")
}

// ─── Course evaluations ──────────────────────────────────────
model CourseEvaluation {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String    @map("user_id")
  courseId    String    @map("course_id")
  responses   Json
  submittedAt DateTime? @default(now()) @map("submitted_at") @db.Timestamp(6)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([userId, courseId])
  @@map("course_evaluations")
}

// ─── Instructor applications to teach a course ──────────────
model CourseInstructorApplication {
  id         String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  courseId   String             @map("course_id")
  userId     String             @map("user_id")
  status     ApplicationStatus  @default(PENDING)
  message    String?
  appliedAt  DateTime           @default(now()) @map("applied_at") @db.Timestamptz(6)
  reviewedAt DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  course     Course             @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([courseId, userId])
  @@map("course_instructor_applications")
}

// ─── Per-user lesson completion tracking ────────────────────
model LessonCompletion {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String    @map("user_id")
  lessonId    String    @map("lesson_id")
  completedAt DateTime? @default(now()) @map("completed_at") @db.Timestamp(6)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([userId, lessonId])
  @@index([userId], map: "idx_lesson_comp_user")
  @@map("lesson_completions")
}

model Question {
  id            String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  assessmentId  String            @map("assessment_id")
  questionText  String            @map("question_text")
  questionType  String            @default("MCQ") @map("question_type")
  points        Int               @default(1)
  order         Int               @default(0)
  createdAt     DateTime?         @default(now()) @map("created_at") @db.Timestamp(6)
  assessment    Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  options       QuestionOption[]
  studentAnswers StudentAnswer[]
  @@index([assessmentId], map: "idx_questions_assessment")
  @@map("questions")
}

model QuestionOption {
  id             String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  questionId     String           @map("question_id")
  optionText     String           @map("option_text")
  isCorrect      Boolean          @default(false) @map("is_correct")
  order          Int              @default(0)
  question       Question         @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  studentAnswers StudentAnswer[]
  @@index([questionId], map: "idx_options_question")
  @@map("question_options")
}

model StudentAnswer {
  id               String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  submissionId     String          @map("submission_id")
  questionId       String          @map("question_id")
  selectedOptionId String?         @map("selected_option_id")
  isCorrect        Boolean?        @default(false) @map("is_correct")
  pointsEarned     Int?            @default(0) @map("points_earned")
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  submission       Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([submissionId, questionId])
  @@index([submissionId], map: "idx_answers_submission")
  @@map("student_answers")
}

model StudentGroupMember {
  id             String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  groupId        String        @map("group_id")
  userId         String        @map("user_id")
  joinedAt       DateTime?     @default(now()) @map("joined_at") @db.Timestamp(6)
  group          StudentGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([groupId, userId])
  @@map("student_group_members")
}

model StudentGroup {
  id          String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  courseId    String                @map("course_id")
  name        String
  createdAt   DateTime?             @default(now()) @map("created_at") @db.Timestamp(6)
  assessments Assessment[]
  members     StudentGroupMember[]
  course      Course                @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([courseId, name])
  @@map("student_groups")
}
